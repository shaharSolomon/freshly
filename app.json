{
  "expo": {
    "name": "freshly",
    "slug": "freshly",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.freshly"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.freshly"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "freshly",
    "plugins": [
      "expo-router",
      [
        "expo-localization",
        {
          "supportsRTL": true,
          "forcesRTL": true
        }
      ],
      [
        "expo-notifications",
        {}
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "freshly צריכה גישה למצלמה כדי לסרוק קבלות"
        }
      ]
    ],
    "extra": {
      "supportsRTL": true
    }
  }
}
